<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<VBox fx:id="vbxPrincipal" styleClass="root-container" stylesheets="@../css/ListaSerieDocumento.css" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.robin.pos.controller.ListaSerieDocumentoController">
    
    <!-- ==================== CABECERA ==================== -->
    <VBox spacing="15" styleClass="header-container">
        <padding>
            <Insets bottom="20" left="25" right="25" top="20" />
        </padding>
        
        <!-- Título y subtítulo -->
        <VBox spacing="3">
            <Label fx:id="lblTitulo" styleClass="header-title" text="Gestión de Series de Documentos" />
            <Label fx:id="lblSubtitulo" styleClass="header-subtitle" text="Administra las series y correlativos de documentos" />
        </VBox>
        
        <!-- Barra de herramientas -->
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="toolbar-container">
            <padding>
                <Insets bottom="12" left="15" right="15" top="12" />
            </padding>
            
            <!-- Campo de búsqueda -->
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="search-container" HBox.hgrow="SOMETIMES">
                <padding>
                    <Insets bottom="8" left="15" right="15" top="8" />
                </padding>
                <SVGPath content="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" scaleX="0.85" scaleY="0.85" styleClass="search-icon" />
                <TextField fx:id="txtBuscar" onKeyPressed="#buscarSerie" prefWidth="280" promptText="Buscar por serie, centro o tipo de documento..." styleClass="search-field" />
            </HBox>
            
            <!-- Filtro por centro -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label styleClass="filter-label" text="Centro:" />
                <ComboBox fx:id="cbxCentro" onAction="#filtrarPorCentro" prefHeight="25.0" prefWidth="120.0" styleClass="filter-combo">
                    <cursor><Cursor fx:constant="HAND" /></cursor>
                </ComboBox>
            </HBox>
            
            <!-- Filtro por tipo documento -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label styleClass="filter-label" text="Tipo Doc:" />
                <ComboBox fx:id="cbxTipoDoc" onAction="#filtrarPorTipoDoc" prefHeight="25.0" prefWidth="120.0" styleClass="filter-combo">
                    <cursor><Cursor fx:constant="HAND" /></cursor>
                </ComboBox>
            </HBox>
            
            <!-- Filtro por estado -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label styleClass="filter-label" text="Estado:" />
                <ComboBox fx:id="cbxEstado" onAction="#filtrarPorEstado" prefHeight="25.0" prefWidth="100.0" styleClass="filter-combo">
                    <cursor><Cursor fx:constant="HAND" /></cursor>
                </ComboBox>
            </HBox>
            
            <Region HBox.hgrow="ALWAYS" />
            
            <!-- Botones de acción -->
            <HBox alignment="CENTER_RIGHT" spacing="8">
                
                <!-- Botón Nuevo -->
                <Button fx:id="btnNuevo" onAction="#abrirFormularioNuevo" styleClass="btn-new">
                    <graphic>
                        <SVGPath content="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" scaleX="0.75" scaleY="0.75" styleClass="btn-icon" />
                    </graphic>
                    <tooltip><Tooltip text="Agregar nueva serie (Ctrl+N)" /></tooltip>
                    <cursor><Cursor fx:constant="HAND" /></cursor>
                </Button>
                
                <!-- Botón Editar -->
                <Button fx:id="btnEditar" disable="true" onAction="#abrirFormularioEditar" styleClass="btn-edit">
                    <graphic>
                        <SVGPath content="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" scaleX="0.7" scaleY="0.7" styleClass="btn-icon" />
                    </graphic>
                    <tooltip><Tooltip text="Editar serie seleccionada (Ctrl+E)" /></tooltip>
                    <cursor><Cursor fx:constant="HAND" /></cursor>
                </Button>
                
                <!-- Botón Eliminar -->
                <Button fx:id="btnEliminar" disable="true" onAction="#eliminarSerie" styleClass="btn-delete">
                    <graphic>
                        <SVGPath content="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" scaleX="0.7" scaleY="0.7" styleClass="btn-icon" />
                    </graphic>
                    <tooltip><Tooltip text="Eliminar serie seleccionada (Delete)" /></tooltip>
                    <cursor><Cursor fx:constant="HAND" /></cursor>
                </Button>
                
                <!-- Botón Actualizar -->
                <Button fx:id="btnActualizar" onAction="#actualizarLista" styleClass="btn-refresh">
                    <graphic>
                        <SVGPath content="M17.65 6.35A7.958 7.958 0 0 0 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08A5.99 5.99 0 0 1 12 18c-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" scaleX="0.7" scaleY="0.7" styleClass="btn-icon" />
                    </graphic>
                    <tooltip><Tooltip text="Actualizar lista (F5)" /></tooltip>
                    <cursor><Cursor fx:constant="HAND" /></cursor>
                </Button>
            </HBox>
        </HBox>
    </VBox>
    
    <!-- ==================== TABLA ==================== -->
    <VBox styleClass="table-wrapper" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="20" left="25" right="25" top="0" />
        </padding>
        
        <StackPane styleClass="table-container" VBox.vgrow="ALWAYS">
            <effect>
                <DropShadow blurType="GAUSSIAN" color="#00000015" offsetY="4" radius="12" />
            </effect>
            
            <TableView fx:id="tblSeries" onKeyPressed="#manejarTeclas" onMouseClicked="#manejarDobleClick" styleClass="modern-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCentro" minWidth="54.39999657869339" prefWidth="67.99999886751175" text="Centro" />
                    <TableColumn fx:id="colTipoDoc" minWidth="100" prefWidth="318.4000015258789" text="Tipo Documento" />
                    <TableColumn fx:id="colSerie" minWidth="63.20001220703125" prefWidth="63.20001220703125" text="Serie" />
                    <TableColumn fx:id="colConsDesde" minWidth="100" prefWidth="120" text="Cons. Desde" />
                    <TableColumn fx:id="colLineas" minWidth="80" prefWidth="140.7999267578125" text="Líneas" />
                    <TableColumn fx:id="colControlAuto" minWidth="96.800048828125" prefWidth="96.800048828125" text="Control Auto" />
                    <TableColumn fx:id="colActivo" minWidth="80" prefWidth="131.2000732421875" text="Activo" />
                    <TableColumn fx:id="colNoCaba" minWidth="80" prefWidth="82.39984130859375" text="Cod. Caja" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </StackPane>
    </VBox>
    
    <!-- ==================== BARRA DE ESTADO ==================== -->
    <HBox alignment="CENTER_LEFT" spacing="20" styleClass="status-bar">
        <padding>
            <Insets bottom="10" left="25" right="25" top="10" />
        </padding>
        
        <HBox alignment="CENTER_LEFT" spacing="15">
            <Label styleClass="shortcut-hint" text="Ctrl+N: Nuevo" />
            <Label styleClass="shortcut-hint" text="Ctrl+E: Editar" />
            <Label styleClass="shortcut-hint" text="Delete: Eliminar" />
            <Label styleClass="shortcut-hint" text="F5: Actualizar" />
            <Label styleClass="shortcut-hint" text="Doble clic: Editar" />
        </HBox>
        
        <Region HBox.hgrow="ALWAYS" />
        
        <!-- Contador de registros -->
        <HBox alignment="CENTER" spacing="8" styleClass="counter-container">
            <padding>
                <Insets bottom="8" left="15" right="15" top="8" />
            </padding>
            <SVGPath content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z" scaleX="0.8" scaleY="0.8" styleClass="counter-icon" />
            <Label fx:id="lblContador" styleClass="counter-label" text="0 Series" />
        </HBox>
    </HBox>
</VBox>
