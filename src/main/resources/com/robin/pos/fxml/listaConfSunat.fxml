<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<VBox styleClass="root-container" stylesheets="@../css/ListaConfSunat.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.robin.pos.controller.ListaConfSunatController">
    
    <!-- ==================== CABECERA ==================== -->
    <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="header-container">
        <padding>
            <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
        </padding>
        
        <SVGPath content="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z" scaleX="1.3" scaleY="1.3" styleClass="header-icon" />
        
        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
            <Label styleClass="header-title" text="Configuración SUNAT" />
            <Label styleClass="header-subtitle" text="Gestión de parámetros para facturación electrónica" />
        </VBox>
    </HBox>
    
    <!-- ==================== BARRA DE BÚSQUEDA Y FILTROS ==================== -->
    <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="search-bar">
        <padding>
            <Insets bottom="15.0" left="25.0" right="25.0" top="15.0" />
        </padding>
        
        <Label styleClass="search-label" text="Buscar:" />
        
        <TextField fx:id="txtBuscar" prefHeight="38.0" prefWidth="300.0" promptText="Código o descripción..." styleClass="search-field" HBox.hgrow="ALWAYS">
            <cursor><Cursor fx:constant="TEXT" /></cursor>
        </TextField>
        
        <Label styleClass="search-label" text="Grupo:" />
        
        <ComboBox fx:id="cbxFiltroGrupo" prefHeight="38.0" prefWidth="220.0" promptText="Todos los grupos" styleClass="combo-filter">
            <cursor><Cursor fx:constant="HAND" /></cursor>
        </ComboBox>
        
        <Button fx:id="btnRefrescar" onAction="#refrescar" styleClass="btn-refresh">
            <graphic>
                <SVGPath content="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" styleClass="icon-white" />
            </graphic>
            <tooltip><Tooltip text="Refrescar lista (F5)" /></tooltip>
            <cursor><Cursor fx:constant="HAND" /></cursor>
        </Button>
        
        <Button fx:id="btnNuevo" onAction="#nuevo" styleClass="btn-new">
            <graphic>
                <HBox alignment="CENTER" spacing="8.0">
                    <SVGPath content="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" styleClass="icon-white" />
                    <Label styleClass="btn-label" text="NUEVO" />
                </HBox>
            </graphic>
            <tooltip><Tooltip text="Nueva configuración (Ctrl+N)" /></tooltip>
            <cursor><Cursor fx:constant="HAND" /></cursor>
        </Button>
    </HBox>
    
    <!-- ==================== TABLA DE DATOS ==================== -->
    <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="content-scroll" VBox.vgrow="ALWAYS">
        <VBox spacing="0.0">
            <padding>
                <Insets bottom="25.0" left="25.0" right="25.0" top="5.0" />
            </padding>
            
            <TableView fx:id="tblConfiguraciones" styleClass="data-table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCodigo" prefWidth="200.0" text="CÓDIGO" />
                    <TableColumn fx:id="colDescripcion" prefWidth="280.0" text="DESCRIPCIÓN" />
                    <TableColumn fx:id="colValor" prefWidth="250.0" text="VALOR" />
                    <TableColumn fx:id="colGrupo" prefWidth="180.0" text="GRUPO" />
                    <TableColumn fx:id="colTipoDato" prefWidth="100.0" text="TIPO" />
                    <TableColumn fx:id="colActivo" prefWidth="100.0" text="ESTADO" />
                </columns>
                <cursor><Cursor fx:constant="HAND" /></cursor>
            </TableView>
        </VBox>
    </ScrollPane>
    
    <!-- ==================== FOOTER CON BOTONES ==================== -->
    <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="footer-container">
        <padding>
            <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
        </padding>
        
        <Label fx:id="lblTotalRegistros" styleClass="footer-label" text="Total: 0 configuraciones" />
        
        <Region HBox.hgrow="ALWAYS" />
        
        <Button fx:id="btnEditar" onAction="#editar" styleClass="btn-edit">
            <graphic>
                <HBox alignment="CENTER" spacing="8.0">
                    <SVGPath content="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" styleClass="icon-white" />
                    <Label styleClass="btn-label" text="EDITAR" />
                </HBox>
            </graphic>
            <tooltip><Tooltip text="Editar configuración seleccionada (Enter)" /></tooltip>
            <cursor><Cursor fx:constant="HAND" /></cursor>
        </Button>
        
        <Button fx:id="btnEliminar" onAction="#eliminar" styleClass="btn-delete">
            <graphic>
                <HBox alignment="CENTER" spacing="8.0">
                    <SVGPath content="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" styleClass="icon-white" />
                    <Label styleClass="btn-label" text="ELIMINAR" />
                </HBox>
            </graphic>
            <tooltip><Tooltip text="Eliminar configuración seleccionada (Delete)" /></tooltip>
            <cursor><Cursor fx:constant="HAND" /></cursor>
        </Button>
    </HBox>
</VBox>
